{
  "name": "@aiox/ui",
  "version": "0.1.0",
  "description": "Design system do ecossistema AIOX — Clínico Premium",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "files": [
    "dist",
    "tailwind-preset.js",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \".storybook/**/*.ts\" \"*.config.ts\"",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build && npm test -- --run"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.400.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^24.0.0",
    "storybook": "^8.6.19",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@storybook/addon-actions": {
      "uuid": "^11.1.1"
    },
    "baseline-browser-mapping": "^2.11.32",
    "browserslist": "^4.29.4",
    "minimatch@9.0.9": {
      "brace-expansion": "^2.1.7"
    },
    "postcss": "^8.5.31",
    "postcss-nested": "^7.0.2",
    "postcss-selector-parser": "^7.1.7"
  }
}
